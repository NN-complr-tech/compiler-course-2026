# RUN: llc -mtriple x86_64-unknown-linux-gnu -load %llvmshlibdir/dolov_v_lab3_BACKEND%shlibext -run-pass=inc-dec-to-add-sub %s -o - | FileCheck %s

---
name:            test_inc_dec_folding
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $al, $ax, $edi, $rsi, $r8, $r9, $rdi

    ; CHECK: $al = ADD8ri $al, 2, implicit-def $eflags
    $al = INC8r $al, implicit-def $eflags
    $al = INC8r $al, implicit-def $eflags

    ; CHECK: $ax = SUB16ri $ax, 3, implicit-def $eflags
    $ax = DEC16r $ax, implicit-def $eflags
    $ax = DEC16r $ax, implicit-def $eflags
    $ax = DEC16r $ax, implicit-def $eflags

    ; CHECK: $edi = ADD32ri $edi, 2, implicit-def $eflags
    $edi = INC32r $edi, implicit-def $eflags
    $edi = INC32r $edi, implicit-def $eflags

    ; CHECK: $rsi = SUB64ri32 $rsi, 2, implicit-def $eflags
    $rsi = DEC64r $rsi, implicit-def $eflags
    $rsi = DEC64r $rsi, implicit-def $eflags

    ; CHECK-NOT: INC32r
    ; CHECK-NOT: DEC32r
    $edi = INC32r $edi, implicit-def $eflags
    $edi = DEC32r $edi, implicit-def $eflags

    ; CHECK: $r8 = ADD64ri32 $r8, 1, implicit-def $eflags
    ; CHECK: $r9 = SUB64ri32 $r9, 1, implicit-def $eflags
    $r8 = INC64r $r8, implicit-def $eflags
    $r9 = DEC64r $r9, implicit-def $eflags

    ; CHECK: $edi = ADD32ri $edi, 1, implicit-def $eflags
    ; CHECK: $rdi = ADD64ri32 $rdi, 1, implicit-def $eflags
    $edi = INC32r $edi, implicit-def $eflags
    $rdi = INC64r $rdi, implicit-def $eflags

    RET64

---
name:            test_multiple_blocks
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $edi
    ; CHECK: $edi = ADD32ri $edi, 2, implicit-def $eflags
    $edi = INC32r $edi, implicit-def $eflags
    $edi = INC32r $edi, implicit-def $eflags
    JMP_1 %bb.1

  bb.1:
    liveins: $edi
    ; CHECK: $edi = SUB32ri $edi, 2, implicit-def $eflags
    $edi = DEC32r $edi, implicit-def $eflags
    $edi = DEC32r $edi, implicit-def $eflags
    RET64