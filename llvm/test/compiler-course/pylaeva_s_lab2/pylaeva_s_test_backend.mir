# RUN: llc -mtriple x86_64-unknown-linux-gnu --load=%llvmshlibdir/pylaeva_s_lab3_BACKEND%shlibext \
# RUN: -run-pass=function-inlining  %s -o - | FileCheck %s

# ********************************************************************
# TEST CASE 1: Basic function inlining
# ********************************************************************

# CHECK-LABEL: name: caller1
# CHECK: MOV32ri
# CHECK: SUB32ri
# CHECK-NOT: CALL64pcrel32 @subtraction

---
name: subtraction
tracksRegLiveness: true
body: |
  bb.0:
    %0:gr32 = MOV32ri 2
    %1:gr32 = SUB32ri %0, 1, implicit-def $eflags
    RET64
...
---
name: caller1
tracksRegLiveness: true
body: |
  bb.0:
    CALL64pcrel32 @subtraction
    RET64
...
# ********************************************************************
# TEST CASE 2: Function with 14 instructions (below threshold) - should inline
# ********************************************************************

# CHECK-LABEL: name: caller14
# CHECK-NOT: CALL64pcrel32 @less_than_15
# CHECK: MOV32ri
# CHECK: MOV32ri
# CHECK: MOV32ri
# CHECK: MOV32ri
# CHECK: MOV32ri
# CHECK: MOV32ri
# CHECK: MOV32ri
# CHECK: MOV32ri
# CHECK: MOV32ri
# CHECK: MOV32ri
# CHECK: MOV32ri
# CHECK: MOV32ri
# CHECK: RET64

---
name: less_than_15
tracksRegLiveness: true
body: |
  bb.0:
    %0:gr32 = MOV32ri 0
    %1:gr32 = MOV32ri 1
    %2:gr32 = MOV32ri 2
    %3:gr32 = MOV32ri 3
    %4:gr32 = MOV32ri 4
    %5:gr32 = MOV32ri 5
    %6:gr32 = MOV32ri 6
    %7:gr32 = MOV32ri 7
    %8:gr32 = MOV32ri 8
    %9:gr32 = MOV32ri 9
    %10:gr32 = MOV32ri 10
    %11:gr32 = MOV32ri 11
    %12:gr32 = MOV32ri 12
    RET64
...
---
name: caller14
tracksRegLiveness: true
body: |
  bb.0:
    CALL64pcrel32 @less_than_15
    RET64
...
# ********************************************************************
# TEST CASE 3: Function with 15 instructions (at threshold) - should inline
# ********************************************************************

# CHECK-LABEL: name: caller15
# CHECK-NOT: CALL64pcrel32 @exactly_15
# CHECK: MOV32ri
# CHECK: MOV32ri
# CHECK: MOV32ri
# CHECK: MOV32ri
# CHECK: MOV32ri
# CHECK: MOV32ri
# CHECK: MOV32ri
# CHECK: MOV32ri
# CHECK: MOV32ri
# CHECK: MOV32ri
# CHECK: MOV32ri
# CHECK: MOV32ri
# CHECK: MOV32ri
# CHECK: RET64

---
name: exactly_15
tracksRegLiveness: true
body: |
  bb.0:
    %0:gr32 = MOV32ri 0
    %1:gr32 = MOV32ri 1
    %2:gr32 = MOV32ri 2
    %3:gr32 = MOV32ri 3
    %4:gr32 = MOV32ri 4
    %5:gr32 = MOV32ri 5
    %6:gr32 = MOV32ri 6
    %7:gr32 = MOV32ri 7
    %8:gr32 = MOV32ri 8
    %9:gr32 = MOV32ri 9
    %10:gr32 = MOV32ri 10
    %11:gr32 = MOV32ri 11
    %12:gr32 = MOV32ri 12
    %13:gr32 = MOV32ri 13
    RET64
...
---
name: caller15
tracksRegLiveness: true
body: |
  bb.0:
    CALL64pcrel32 @exactly_15
    RET64
...
# ********************************************************************
# TEST CASE 4: Function with 16 instructions (above threshold) - should NOT inline
# ********************************************************************

# CHECK-LABEL: name: caller16
# CHECK: CALL64pcrel32 @more_than_15

---
name: more_than_15
tracksRegLiveness: true
body: |
  bb.0:
    %0:gr32 = MOV32ri 0
    %1:gr32 = MOV32ri 1
    %2:gr32 = MOV32ri 2
    %3:gr32 = MOV32ri 3
    %4:gr32 = MOV32ri 4
    %5:gr32 = MOV32ri 5
    %6:gr32 = MOV32ri 6
    %7:gr32 = MOV32ri 7
    %8:gr32 = MOV32ri 8
    %9:gr32 = MOV32ri 9
    %10:gr32 = MOV32ri 10
    %11:gr32 = MOV32ri 11
    %12:gr32 = MOV32ri 12
    %13:gr32 = MOV32ri 13
    %14:gr32 = MOV32ri 14
    %15:gr32 = MOV32ri 15
    RET64
...
---
name: caller16
tracksRegLiveness: true
body: |
  bb.0:
    CALL64pcrel32 @more_than_15
    RET64
...
# ********************************************************************
# TEST CASE 5: Nested function inlining (three levels deep)
# ********************************************************************

# CHECK-LABEL: name: foo3
# CHECK: MOV32ri
# CHECK: ADD32ri
# CHECK-NOT: CALL64pcrel32 @foo2
# CHECK-NOT: CALL64pcrel32 @foo1

---
name: foo1
body: |
  bb.0:
    %0:gr32 = MOV32ri 1
    %1:gr32 = ADD32ri %0, 1, implicit-def $eflags
    RET64
...
---
name: foo2
body: |
  bb.0:
    CALL64pcrel32 @foo1
    RET64
...
---
name: foo3
body: |
  bb.0:
    CALL64pcrel32 @foo2
    RET64
...
# ********************************************************************
# TEST CASE 6: Recursive function with depth limit (max 3 calls)
# ********************************************************************

# CHECK-LABEL: name: recursive_function
# CHECK: MOV32ri
# CHECK: MOV32ri
# CHECK: MOV32ri
# CHECK: CALL64pcrel32 @recursive_function

---
name: recursive_function
tracksRegLiveness: true
body: |
  bb.0:
    %0:gr32 = MOV32ri 1
    CALL64pcrel32 @recursive_function
    RET64
...

