# RUN: llc -mtriple x86_64-unknown-linux-gnu \
# RUN:     --load=%llvmshlibdir/rychkova_d_lab3_BACKEND%shlibext \
# RUN:     -run-pass=loop-unroll-limited \
# RUN:     %s -o - | FileCheck %s

--- |
  define void @unroll_3_iter() {
  entry:
    br label %loop
  loop:
    %i = phi i32 [ 0, %entry ], [ %next, %loop ]
    %next = add i32 %i, 1
    %cond = icmp slt i32 %next, 3
    br i1 %cond, label %loop, label %exit
  exit:
    ret void
  }

  define void @unroll_4_iter() {
  entry:
    br label %loop
  loop:
    %i = phi i32 [ 0, %entry ], [ %next, %loop ]
    %next = add i32 %i, 1
    %cond = icmp slt i32 %next, 4
    br i1 %cond, label %loop, label %exit
  exit:
    ret void
  }

  define void @unroll_5_iter() {
  entry:
    br label %loop
  loop:
    %i = phi i32 [ 0, %entry ], [ %next, %loop ]
    %next = add i32 %i, 1
    %cond = icmp slt i32 %next, 5
    br i1 %cond, label %loop, label %exit
  exit:
    ret void
  }

  define void @keep_6_iter() {
  entry:
    br label %loop
  loop:
    %i = phi i32 [ 0, %entry ], [ %next, %loop ]
    %next = add i32 %i, 1
    %cond = icmp slt i32 %next, 6
    br i1 %cond, label %loop, label %exit
  exit:
    ret void
  }

  define void @keep_7_iter() {
  entry:
    br label %loop
  loop:
    %i = phi i32 [ 0, %entry ], [ %next, %loop ]
    %next = add i32 %i, 1
    %cond = icmp slt i32 %next, 7
    br i1 %cond, label %loop, label %exit
  exit:
    ret void
  }

  define void @nested_inner_2_outer_3() {
  outer_entry:
    br label %outer
  outer:
    %j = phi i32 [ 0, %outer_entry ], [ %j_next, %outer_latch ]
    br label %inner
  inner:
    %i = phi i32 [ 0, %outer ], [ %i_next, %inner ]
    %i_next = add i32 %i, 1
    %icond = icmp slt i32 %i_next, 2
    br i1 %icond, label %inner, label %outer_latch
  outer_latch:
    %j_next = add i32 %j, 1
    %jcond = icmp slt i32 %j_next, 3
    br i1 %jcond, label %outer, label %exit
  exit:
    ret void
  }

  define void @nested_inner_3_outer_2() {
  outer_entry:
    br label %outer
  outer:
    %j = phi i32 [ 0, %outer_entry ], [ %j_next, %outer_latch ]
    br label %inner
  inner:
    %i = phi i32 [ 0, %outer ], [ %i_next, %inner ]
    %i_next = add i32 %i, 1
    %icond = icmp slt i32 %i_next, 3
    br i1 %icond, label %inner, label %outer_latch
  outer_latch:
    %j_next = add i32 %j, 1
    %jcond = icmp slt i32 %j_next, 2
    br i1 %jcond, label %outer, label %exit
  exit:
    ret void
  }

  define void @while_style_3() {
  entry:
    br label %header
  header:
    %val = phi i32 [ 0, %entry ], [ %val_next, %body ]
    %cond = icmp slt i32 %val, 3
    br i1 %cond, label %body, label %exit
  body:
    %val_next = add i32 %val, 1
    br label %header
  exit:
    ret void
  }

  define void @arith_loop_4() {
  entry:
    br label %loop
  loop:
    %i = phi i32 [ 0, %entry ], [ %i_next, %loop ]
    %add = add i32 %i, 5
    %sub = sub i32 %add, 2
    %mul = mul i32 %sub, 3
    %i_next = add i32 %i, 1
    %cond = icmp slt i32 %i_next, 4
    br i1 %cond, label %loop, label %exit
  exit:
    ret void
  }
...
# CHECK-LABEL: unroll_3_iter
# CHECK: ADD32ri8
# CHECK: CMP32ri8 $ebx, 3

# CHECK-LABEL: unroll_4_iter
# CHECK: ADD32ri8
# CHECK: CMP32ri8 $ebx, 4

# CHECK-LABEL: unroll_5_iter
# CHECK: ADD32ri8
# CHECK: CMP32ri8 $ebx, 5

# CHECK-LABEL: keep_6_iter
# CHECK: ADD32ri8
# CHECK: CMP32ri8 $ebx, 6

# CHECK-LABEL: keep_7_iter
# CHECK: ADD32ri8
# CHECK: CMP32ri8 $ebx, 7

# CHECK-LABEL: nested_inner_2_outer_3
# CHECK: ADD32ri8
# CHECK: CMP32ri8 $edx, 2
# CHECK: CMP32ri8 $esi, 3

# CHECK-LABEL: nested_inner_3_outer_2
# CHECK: ADD32ri8
# CHECK: CMP32ri8 $edx, 3
# CHECK: CMP32ri8 $esi, 2

# CHECK-LABEL: while_style_3
# CHECK: CMP32ri8 $eax, 3
# CHECK: ADD32ri8 $eax, 1

# CHECK-LABEL: arith_loop_4
# CHECK: ADD32ri8
# CHECK: SUB32ri8
# CHECK: IMUL32rri8
