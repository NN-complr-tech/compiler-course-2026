# RUN: llc -mtriple x86_64-unknown-linux-gnu --load=%llvmshlibdir/rychkova_d_lab3_BACKEND%shlibext -run-pass=loop-unroll-limited %s -o - | FileCheck %s

--- |
  define void @unroll_3() {
  entry:
    br label %loop
  loop:
    %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
    %i.next = add i32 %i, 1
    %cond = icmp slt i32 %i.next, 3
    br i1 %cond, label %loop, label %exit
  exit:
    ret void
  }
# CHECK-LABEL: unroll_3
# CHECK: ret void

--- |
  define void @no_unroll_7() {
  entry:
    br label %loop
  loop:
    %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
    %i.next = add i32 %i, 1
    %cond = icmp slt i32 %i.next, 7
    br i1 %cond, label %loop, label %exit
  exit:
    ret void
  }
# CHECK-LABEL: no_unroll_7
# CHECK: ret void

--- |
  define void @nested_loops() {
  entry:
    br label %outer
  outer:
    %j = phi i32 [ 0, %entry ], [ %j.next, %outer_latch ]
    br label %inner
  inner:
    %i = phi i32 [ 0, %outer ], [ %i.next, %inner ]
    %i.next = add i32 %i, 1
    %icond = icmp slt i32 %i.next, 2
    br i1 %icond, label %inner, label %outer_latch
  outer_latch:
    %j.next = add i32 %j, 1
    %jcond = icmp slt i32 %j.next, 3
    br i1 %jcond, label %outer, label %exit
  exit:
    ret void
  }
# CHECK-LABEL: nested_loops
# CHECK: ret void