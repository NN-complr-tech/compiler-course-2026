# RUN: llc -mtriple x86_64-unknown-linux-gnu --load=%llvmshlibdir/rychkova_d_lab3_BACKEND%shlibext -run-pass=loop-unroll-limited %s -o - | FileCheck %s

--- |
  define void @unroll_3_iter() {
  entry:
    br label %loop
  loop:
    %i = phi i32 [ 0, %entry ], [ %next, %loop ]
    %next = add i32 %i, 1
    %cond = icmp slt i32 %next, 3
    br i1 %cond, label %loop, label %exit
  exit:
    ret void
  }
...
# CHECK-LABEL: define void @unroll_3_iter
# CHECK: phi i32
# CHECK: add i32
# CHECK: icmp slt

--- |
  define void @unroll_5_iter() {
  entry:
    br label %loop
  loop:
    %i = phi i32 [ 0, %entry ], [ %next, %loop ]
    %next = add i32 %i, 1
    %cond = icmp slt i32 %next, 5
    br i1 %cond, label %loop, label %exit
  exit:
    ret void
  }
...
# CHECK-LABEL: define void @unroll_5_iter
# CHECK: phi i32
# CHECK: add i32
# CHECK: icmp slt

--- |
  define void @keep_7_iter() {
  entry:
    br label %loop
  loop:
    %i = phi i32 [ 0, %entry ], [ %next, %loop ]
    %next = add i32 %i, 1
    %cond = icmp slt i32 %next, 7
    br i1 %cond, label %loop, label %exit
  exit:
    ret void
  }
...
# CHECK-LABEL: define void @keep_7_iter
# CHECK: phi i32
# CHECK: add i32
# CHECK: icmp slt

--- |
  define void @nested_inner_2_outer_3() {
  outer_entry:
    br label %outer
  outer:
    %j = phi i32 [ 0, %outer_entry ], [ %j_next, %outer_latch ]
    br label %inner
  inner:
    %i = phi i32 [ 0, %outer ], [ %i_next, %inner ]
    %i_next = add i32 %i, 1
    %icond = icmp slt i32 %i_next, 2
    br i1 %icond, label %inner, label %outer_latch
  outer_latch:
    %j_next = add i32 %j, 1
    %jcond = icmp slt i32 %j_next, 3
    br i1 %jcond, label %outer, label %exit
  exit:
    ret void
  }
...
# CHECK-LABEL: define void @nested_inner_2_outer_3
# CHECK: phi i32
# CHECK: add i32
# CHECK: icmp slt

--- |
  define void @while_style_3() {
  entry:
    br label %header
  header:
    %val = phi i32 [ 0, %entry ], [ %val_next, %body ]
    %cond = icmp slt i32 %val, 3
    br i1 %cond, label %body, label %exit
  body:
    %val_next = add i32 %val, 1
    br label %header
  exit:
    ret void
  }
...
# CHECK-LABEL: define void @while_style_3
# CHECK: phi i32
# CHECK: icmp slt
# CHECK: add i32

--- |
  define void @arith_loop_4() {
  entry:
    br label %loop
  loop:
    %i = phi i32 [ 0, %entry ], [ %i_next, %loop ]
    %add = add i32 %i, 5
    %sub = sub i32 %add, 2
    %mul = mul i32 %sub, 3
    %i_next = add i32 %i, 1
    %cond = icmp slt i32 %i_next, 4
    br i1 %cond, label %loop, label %exit
  exit:
    ret void
  }
...
# CHECK-LABEL: define void @arith_loop_4
# CHECK: phi i32
# CHECK: add i32
# CHECK: mul i32
# CHECK: icmp slt
