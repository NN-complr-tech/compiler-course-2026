# RUN: llc -mtriple x86_64-unknown-linux-gnu \
# RUN:     --load=%llvmshlibdir/rychkova_d_lab3_BACKEND%shlibext \
# RUN:     -run-pass=loop-unroll-limited \
# RUN:     %s -o - | FileCheck %s

--- |
  define void @unroll_3_iter() local_unnamed_addr {
  entry:   br label %header
  header:
    %counter = phi i32 [ 0, %entry ], [ %counter_next, %header ]
    %counter_next = add i32 %counter, 1
    %check = icmp slt i32 %counter_next, 3
    br i1 %check, label %header, label %exit
  exit:    ret void
  }

  define void @unroll_5_iter() local_unnamed_addr {
  entry:   br label %header
  header:
    %counter = phi i32 [ 0, %entry ], [ %counter_next, %header ]
    %counter_next = add i32 %counter, 1
    %check = icmp slt i32 %counter_next, 5
    br i1 %check, label %header, label %exit
  exit:    ret void
  }

  define void @skip_unroll_7_iter() local_unnamed_addr {
  entry:   br label %header
  header:
    %counter = phi i32 [ 0, %entry ], [ %counter_next, %header ]
    %counter_next = add i32 %counter, 1
    %check = icmp slt i32 %counter_next, 7
    br i1 %check, label %header, label %exit
  exit:    ret void
  }

  define void @nested_2_and_3() local_unnamed_addr {
  outer_entry: br label %outer_start
  outer_start:
    %j = phi i32 [ 0, %outer_entry ], [ %j_step, %outer_end ]
    br label %inner_start
  inner_start:
    %i = phi i32 [ 0, %outer_start ], [ %i_step, %inner_start ]
    %i_step = add i32 %i, 1
    %i_check = icmp slt i32 %i_step, 2
    br i1 %i_check, label %inner_start, label %outer_end
  outer_end:
    %j_step = add i32 %j, 1
    %j_check = icmp slt i32 %j_step, 3
    br i1 %j_check, label %outer_start, label %outer_exit
  outer_exit: ret void
  }

---
name: unroll_3_iter
tracksRegLiveness: false
body: |
  bb.0.entry:
    successors: %bb.1(0x80000000)
    $r8d = MOV32ri 0
    JMP_1 %bb.1

  bb.1.header:
    successors: %bb.2(0x04000000), %bb.1(0x7c000000)
    $r9d = MOV32rr $r8d
    $r8d = ADD32ri8 $r8d, 1, implicit-def dead $eflags
    CMP32ri8 $r8d, 3, implicit-def $eflags
    JCC_1 %bb.2, 13, implicit killed $eflags
    JMP_1 %bb.1

  bb.2.exit:
    RET64

# CHECK-LABEL: name: unroll_3_iter
# CHECK-COUNT-1: MOV32rr
# CHECK-NOT: JCC_1 %bb.1
# CHECK-NOT: JMP_1 %bb.1

---
name: unroll_5_iter
tracksRegLiveness: false
body: |
  bb.0.entry:
    successors: %bb.1(0x80000000)
    $r8d = MOV32ri 0
    JMP_1 %bb.1

  bb.1.header:
    successors: %bb.2(0x04000000), %bb.1(0x7c000000)
    $r9d = MOV32rr $r8d
    $r8d = ADD32ri8 $r8d, 1, implicit-def dead $eflags
    CMP32ri8 $r8d, 5, implicit-def $eflags
    JCC_1 %bb.2, 13, implicit killed $eflags
    JMP_1 %bb.1

  bb.2.exit:
    RET64

# CHECK-LABEL: name: unroll_5_iter
# CHECK-COUNT-1: MOV32rr
# CHECK-NOT: JCC_1 %bb.1
# CHECK-NOT: JMP_1 %bb.1

---
name: skip_unroll_7_iter
tracksRegLiveness: false
body: |
  bb.0.entry:
    successors: %bb.1(0x80000000)
    $r8d = MOV32ri 0
    JMP_1 %bb.1

  bb.1.header:
    successors: %bb.2(0x04000000), %bb.1(0x7c000000)
    $r9d = MOV32rr $r8d
    $r8d = ADD32ri8 $r8d, 1, implicit-def dead $eflags
    CMP32ri8 $r8d, 7, implicit-def $eflags
    JCC_1 %bb.2, 13, implicit killed $eflags
    JMP_1 %bb.1

  bb.2.exit:
    RET64

# CHECK-LABEL: name: skip_unroll_7_iter
# CHECK: JCC_1 %bb.1, 13
# CHECK: JMP_1 %bb.1

---
name: nested_2_and_3
tracksRegLiveness: false
body: |
  bb.0.outer_entry:
    successors: %bb.1(0x80000000)
    $r8d = MOV32ri 0
    JMP_1 %bb.1

  bb.1.outer_start:
    successors: %bb.2(0x80000000)
    $r9d = MOV32rr $r8d
    $r10d = MOV32ri 0
    JMP_1 %bb.2

  bb.2.inner_start:
    successors: %bb.3(0x04000000), %bb.2(0x7c000000)
    $r11d = MOV32rr $r10d
    $r10d = ADD32ri8 $r10d, 1, implicit-def dead $eflags
    CMP32ri8 $r10d, 2, implicit-def $eflags
    JCC_1 %bb.3, 13, implicit killed $eflags
    JMP_1 %bb.2

  bb.3.outer_end:
    successors: %bb.4(0x04000000), %bb.1(0x7c000000)
    $r8d = ADD32ri8 $r8d, 1, implicit-def dead $eflags
    CMP32ri8 $r8d, 3, implicit-def $eflags
    JCC_1 %bb.4, 13, implicit killed $eflags
    JMP_1 %bb.1

  bb.4.outer_exit:
    RET64

# CHECK-LABEL: name: nested_2_and_3
# CHECK-COUNT-1: MOV32rr
# CHECK: $r10d = ADD32ri8 $r10d, 1
# CHECK: $r8d = ADD32ri8 $r8d, 1
# CHECK: JMP_1 %bb.1